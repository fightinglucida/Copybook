{{- $pages := .RegularPages -}}
{{- if .IsHome -}}{{- $pages = .Site.RegularPages -}}{{- else if eq .Kind "taxonomy" -}}{{- $pages = .Pages -}}{{- end -}}
{{- $pages = partial "sorted-pages" $pages -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ .Title }}{{ if not .IsHome }} · {{ .Site.Title }}{{ end }}</title><link>{{ .Permalink }}</link><description>{{ .Site.Params.description }}</description><language>{{ .Site.Language.LanguageCode }}</language>
{{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
{{ range $pages }}{{ $date := partialCached "publication-date" . .RelPermalink }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid>{{ if not $date.IsZero }}<pubDate>{{ $date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}<description>{{ .Summary | html }}</description></item>{{ end }}
</channel></rss>
